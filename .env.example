# Copy to apps/web/.env.local for local work, or add in Vercel: Project > Settings > Environment Variables.
# Both are optional.

# Public address of the site (canonical links, sitemap, social previews).
# On Vercel it falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=https://arna.example

# Pilot form connector (TZ C-02). Any endpoint that accepts a JSON POST:
# Formspree, Web3Forms, a Google Apps Script web app, an n8n / Make / Zapier webhook.
# Leave empty and the form prepares a ready WhatsApp message for +7 747 167 3817 instead.
# The form sends: { name, contact, eventType, eventTypeLabel, language, page, message }
NEXT_PUBLIC_LEAD_ENDPOINT=

# Only for `npm run demo:audio` (scripts/gen-demo-audio.mjs), which records the demo voice once. Put the real key in
# .env.local (git-ignored), never in this file, never with a NEXT_PUBLIC_ prefix, never in the code. The site itself needs no key.
ELEVENLABS_API_KEY=
